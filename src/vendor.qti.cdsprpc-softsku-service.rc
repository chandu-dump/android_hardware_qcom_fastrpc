# SoftSKU check service for Shikra - disables cdsprpcd for FP1 license
service vendor.cdsprpcd-softsku-sh /vendor/bin/init.cdsprpcd.softsku.sh
    class late_start
    user root
    group system
    oneshot
    seclabel u:r:vendor_qti_init_shell:s0
